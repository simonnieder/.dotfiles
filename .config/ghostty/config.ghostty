term = xterm-256color
font-family = FiraCode Nerd Font Mono
font-size = 13
command = /run/current-system/sw/bin/fish

# Follow the desktop color scheme with a comfortable light palette and the
# existing Vague palette in dark mode.
theme = light:Catppuccin Latte,dark:Vague

cursor-style = block

# Keep tabs available without permanently spending vertical space on the bar.
window-show-tab-bar = never
gtk-custom-css = ~/.config/ghostty/compact-tabs.css

# Ctrl+Tab / Ctrl+Shift+Tab still cycle tabs; open the visual overview on demand.
keybind = ctrl+shift+space=toggle_tab_overview
