// Niri config — ported from ~/.config/hypr/
// Check the wiki for full docs: https://niri-wm.github.io/niri/Configuration:-Introduction


// ==============
// NAMED WORKSPACES (for startup app placement)
// ==============
workspace "1" { open-on-output "eDP-1"; }
workspace "2" { open-on-output "eDP-1"; }
workspace "3" { open-on-output "eDP-1"; }

// ==============
//    OUTPUTS
// ==============
// Run `niri msg outputs` inside niri to find your output names.

debug {
	honor-xdg-activation-with-invalid-serial
}

output "eDP-1" {
    mode "1920x1200"
    scale 1.0
    position x=0 y=0
}

output "HDMI-A-1" {
    mode "1920x1080@60"
    position x=-1920 y=0
}

// ==============
//    INPUT
// ==============
input {
    keyboard {
        xkb {
            layout "de"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        // disable-while-typing is off by default in niri (unlike hyprland)
        scroll-factor 0.2
    }

    mouse {
        // No natural-scroll for mouse
        // accel-profile "flat"   // uncomment if you want flat/no acceleration
    }

    // Makes the mouse warp to newly focused windows
    // warp-mouse-to-focus

    // Focus windows on hover, only if mostly visible (≤5% scroll)
    // Focus windows on hover (won't scroll view)
    focus-follows-mouse max-scroll-amount="0%"
}

// ==============
//   LAYOUT
// ==============
layout {
    gaps 4  // 2px inner + 2px outer equivalent
    always-center-single-column
    background-color "#000000"

    focus-ring {
        // Colors from hypr colors.conf
        active-color   "#8d9199"   // $outline
        inactive-color "#111318"   // $background
        width 2
    }

    border {
        on
        width 2
        active-color   "#8d9199"   // $outline
        inactive-color "#111318"   // $background
        urgent-color   "#ffb4ab"   // $error
    }

    struts {
        left 4
        right 4
        bottom 4
		top 4
    }

    // We use the same proportions as the hypr dwindle defaults
    default-column-width { proportion 0.6667; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
}

// Ask clients to omit their CSD for proper borders/rounding.
// Restart apps after enabling/disabling this.
prefer-no-csd

// X11 apps (like Protégé/Java Swing) need xwayland-satellite on niri.
xwayland-satellite {
    path "/home/simonnieder/.local/bin/xwayland-satellite"
}

// ==============
//  GESTURES
// ==============
gestures {
    hot-corners {
        off
    }
}

// ==============
//  ANIMATIONS
// ==============
// Niri has built-in animations enabled by default.
// animations {
//     off
// }

// ==============
//   STARTUP
// ==============
spawn-at-startup "dunst"
spawn-sh-at-startup "swaybg -i \"$HOME/wallpapers/a_city_skyline_with_a_sunset_in_the_background.png\" -m fill"
spawn-at-startup "waybar"
spawn-at-startup "nm-applet"
spawn-at-startup "blueman-applet"
spawn-sh-at-startup "dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS"
spawn-sh-at-startup "systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS"
spawn-sh-at-startup "systemctl --user restart voxtype.service"
spawn-sh-at-startup "hypridle --config $HOME/.config/niri/hypridle.conf"

// Apps on specific workspaces (window rules below handle placement)
spawn-at-startup "ghostty"
spawn-at-startup "zen-browser"
spawn-at-startup "python3" "/home/simonnieder/.config/niri/float-late-windows.py"
spawn-at-startup "spotify"

// Background set to black in the output blocks above

// Dark theme for GTK
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'"
//spawn-sh-at-startup "gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'"
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3'"

// ==============
//  KEY BINDS
// ==============
binds {
    // --- Hotkey overlay ---
    Mod+Shift+7 { show-hotkey-overlay; }

    // --- Launch programs ---
    Mod+D      hotkey-overlay-title="Run an Application: rofi"  { spawn "rofi" "-show" "drun"; }
    Mod+B      hotkey-overlay-title="Focus Browser"            { spawn-sh "$HOME/.config/scripts/focus-app.sh zen zen-browser"; }
    Mod+S      hotkey-overlay-title="Focus Spotify"            { spawn-sh "$HOME/.config/scripts/focus-app.sh spotify spotify"; }
    Mod+Z      hotkey-overlay-title="Focus Zed"            { spawn-sh "$HOME/.config/scripts/focus-app.sh zed zeditor"; }
    Mod+M      hotkey-overlay-title="Focus Telegram"           { spawn-sh "$HOME/.config/scripts/focus-app.sh telegram Telegram"; }
    Mod+N      hotkey-overlay-title="Focus Obsidian"           { spawn-sh "$HOME/.config/scripts/focus-app.sh obsidian obsidian"; }
    Mod+Return      hotkey-overlay-title="Focus Terminal"           { spawn-sh "$HOME/.config/scripts/focus-app.sh ghostty ghostty"; }
    Mod+E      hotkey-overlay-title="Open File Manager: nautilus" { spawn "nautilus"; }
    Mod+Ctrl+Shift+L hotkey-overlay-title="Lock the Screen: hyprlock"  { spawn "hyprlock"; }
    Mod+Ctrl+Shift+H hotkey-overlay-title="Hibernate"                   { spawn "systemctl" "hibernate"; }
	Mod+X { spawn "voxtype" "record" "toggle"; }

    Mod+Shift+Q              { close-window; }
    Mod+Shift+E              { quit; }
    Mod+Shift+M              { quit; }
    Ctrl+Alt+Delete          { quit; }

    // --- Overview (like hypr's expo) ---
    Mod+O repeat=false { toggle-overview; }

    // --- Fullscreen ---
    Mod+Shift+F { fullscreen-window; }

    // --- Floating ---
    Mod+V { toggle-window-floating; }

    // --- Screenshot ---
	Mod+Shift+S { spawn-sh "grim -g \"$(slurp -w 0 2>/dev/null)\" -t ppm - | satty --filename - --fullscreen current-screen --initial-tool crop --output-filename \"$HOME/images/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png\" --early-exit --actions-on-enter save-to-clipboard --copy-command 'wl-copy'"; }
    Print { spawn-sh "grim -t ppm - | satty --filename - --initial-tool pointer --output-filename \"$HOME/images/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png\" --early-exit --actions-on-enter save-to-clipboard --copy-command 'wl-copy'"; }
    Sys_Req { spawn-sh "grim -t ppm - | satty --filename - --initial-tool pointer --output-filename \"$HOME/images/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png\" --early-exit --actions-on-enter save-to-clipboard --copy-command 'wl-copy'"; }

    // --- Navigation ---
    Mod+H      { focus-column-left; }
    Mod+L      { focus-column-right; }
    Mod+Left   { focus-column-left; }
    Mod+Right  { focus-column-right; }

    // Window-level vertical navigation
    Mod+Up     { focus-window-up; }
    Mod+Down   { focus-window-down; }

    // Workspace switching (vim-style)
    Mod+J { focus-workspace-down; }
    Mod+K { focus-workspace-up; }

    // --- Move windows/columns (Mod+Ctrl) ---
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }

    // --- Monitor navigation ---
    Mod+P       { focus-monitor-next; }
    Mod+Shift+P { focus-monitor-previous; }
    Mod+Ctrl+P       { move-column-to-monitor-next; }
    Mod+Ctrl+Shift+P { move-column-to-monitor-previous; }

    // --- Workspaces ---
    Mod+U       { focus-workspace-down; }
    Mod+I       { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }

    Mod+Ctrl+U       { move-column-to-workspace-down; }
    Mod+Ctrl+I       { move-column-to-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    Mod+Shift+U       { move-workspace-down; }
    Mod+Shift+I       { move-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }

    // --- Workspaces by number (by index) ---
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // --- Previous workspace ---
    Mod+Tab { focus-workspace-previous; }

    // --- Scroll through workspaces ---
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // --- Scroll columns ---
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }

    // --- Reload / restart helpers ---
    Mod+Shift+BackSpace hotkey-overlay-title="Reload Niri Config" { spawn "niri" "msg" "action" "load-config-file"; }
    Mod+Shift+B { spawn "sh" "-c" "~/.config/waybar/restart_waybar.sh"; }

    // --- Column operations ---
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    // Column width adjustments
    Mod+Minus { set-column-width "-10%"; }
    Mod+Plus { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Plus { set-window-height "+10%"; }

    Mod+F      { maximize-column; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Shift+C       { center-column; }

    // --- Tab groups ---
    Mod+T { toggle-column-tabbed-display; }

    // --- Power / idle ---
    Mod+Shift+O { power-off-monitors; }

    // --- Volume (PipeWire) ---
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // --- Media ---
    XF86AudioPlay  allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop  allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev  allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext  allow-when-locked=true { spawn-sh "playerctl next"; }

    // --- Brightness ---
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "10%-"; }
}

// ==============
// WINDOW RULES
// ==============

// --- Startup app placement (only during first 60s after launch) ---
window-rule {
    match at-startup=true app-id=r#"^com\.mitchellh\.ghostty$"#
    open-on-workspace "1"
}

window-rule {
    match app-id=r#"zen"#
    open-on-workspace "2"
    open-maximized true
}

window-rule {
    match app-id=r#"^zed$"#
    match app-id=r#"^dev\.zed\.Zed$"#
    open-maximized true
}

// --- Float certain apps ---
window-rule {
    match app-id=r#"^org\.gnome\.Nautilus$"#
    open-floating true
    default-column-width { proportion 0.8; }
    default-window-height { proportion 0.8; }
}

window-rule {
    match app-id=r#"^telegram-desktop$"#    // Telegram Desktop flatpak
    match app-id=r#"^org\.telegram\.desktop$"#  // Telegram Desktop regular
    open-floating false
    default-column-width { proportion 0.3333; }
}

window-rule {
    match app-id=r#"^spotify$"#
    match app-id=r#"^Spotify$"#
    open-on-workspace "3"
    open-floating false
}

// Float system utilities
window-rule {
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    open-floating true
}

window-rule {
    match app-id=r#"^blueman-manager$"#
    open-floating true
}

window-rule {
    match app-id=r#"^nm-connection-editor$"#
    open-floating true
}

window-rule {
    match app-id=r#"^xdg-desktop-portal-gtk$"#
    open-floating true
}

window-rule {
    match app-id=r#"^com\.gabm\.satty$"#
    open-floating true
}

window-rule {
    match app-id=r#"^localsend$"#
    match app-id=r#"^localsend_app$"#
    open-floating true
}

window-rule {
    match app-id=r#"^org\.gnome\.Loupe$"#
    open-floating true
}

// Bitwarden-on-Zen is handled by ~/.config/niri/float-late-windows.py,
// because the popup sets its final title after opening.

// --- Firefox PiP ---
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// --- WezTerm workaround (from niri defaults) ---
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// --- JetBrains: float, don't auto-focus the splash ---
window-rule {
    match app-id=r#"^(jetbrains-)"#
    open-floating true
    open-focused false
}

// --- Global: rounded corners on all windows (last, so nothing overrides it) ---
window-rule {
    geometry-corner-radius 18
    clip-to-geometry true
    tiled-state true
}

// ==============
//  MISC
// ==============
screenshot-path "~/images/screenshot-%Y-%m-%d_%H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

// ==============
// LID / SWITCH
// ==============
switch-events {
    lid-close { spawn "systemctl" "suspend-then-hibernate"; }
    lid-open  { spawn "niri" "msg" "action" "power-on-monitors"; }
}
