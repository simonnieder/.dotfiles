// Generated by Matugen. Flat surfaces and outlines match the Rofi launcher.
name "Rofi"

tokens {
    width 340
    radius 12
    padding 10 14 12 14
    gap 5
    spacing 8
    font "mono"
    font-size 14
    title-weight 600
    fill "#111318"
    text "#e1e2e9"
    muted "#c4c6cf"
    faint "#8e9199"
    border 2 "#43474e"
    accent "#bdc7dc"
    shadow "flat"
    mark "none"
    enter "fade"
    motion 0.18 0
}

template "card" {
    row gap=8 align="center" {
        icon size=20 radius=6
        text "{summary}" weight="title" grow=#true lines=2
        close size=16 color="faint"
    }
    if "body" { text "{body}" size=13 color="muted" lines=3; }
    if "value" { progress height=3 color="accent"; }
    if "image" { image width=44 height=44 radius=8; }
    if "actions" { actions; }
}

// Hardware feedback needs a state, not a device name and an app subtitle.
template "volume" {
    row gap=8 align="center" {
        icon size=20 radius=6
        if "body" { text "Muted" weight="title" grow=#true; }
        else { text "Volume {value}" weight="title" grow=#true; }
        close size=16 color="faint"
    }
    if "value" { progress height=3 color="accent"; }
}
rule app="Volume" { template "volume"; }

rule urgency="critical" {
    tokens {
        accent "#ffb4ab"
        border 2 "#ffb4ab"
    }
}
