// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
 	"lsp": {
		"tinymist": {
			"initialization_options": {
				// Enable background preview
				// Server will be running on 127.0.0.1:23635
				"preview": {
				"invertColors": "never",
					"background": {
						"enabled": true,
					},
				},
			},

			"settings": {
				// Compile on save
				// This will compile a PDF for the `main.typ` file in the project root.
				"exportPdf": "onSave",
				"outputPath": "$root/$name",

				// Enable formatter
				"formatterMode": "typstyle",
			}
		}
	},
	"languages": {
		"Typst": {
			// Disable soft wrap
			"soft_wrap": "none",
		},
	},
    "search": {
        "button": false
    },
    "scroll_sensitivity": 2.0,
    "cli_default_open_behavior": "existing_window",
    "restore_on_startup": "empty_tab",
    "terminal": {
        "button": false,
        "scroll_multiplier": 5.0,
        "font_weight": 400.0,
        "font_size": 16.0,
        "font_family": "FiraCode Nerd Font Mono",
        "shell": {
            "program": "fish"
        }
    },
    "agent_buffer_font_size": 16.0,
    "agent_servers": {
        "pi-acp": {
            "type": "extension"
        },
        "codex-acp": {
            "type": "extension"
        }
    },
    "diff_view_style": "unified",
    "buffer_font_weight": 400.0,
    "agent": {
        "default_width": 500.0,
        "inline_assistant_model": {
            "provider": "zed.dev",
            "model": "gpt-5.4",
            "enable_thinking": false
        },
        "flexible": false,
        "tool_permissions": {
            "default": "allow",
            "tools": {}
        },
        "dock": "right",
        "favorite_models": [
            {
                "provider": "ollama",
                "model": "kimi-k2.5:cloud",
                "enable_thinking": false
            },
            {
                "provider": "zed.dev",
                "model": "claude-sonnet-4-6",
                "enable_thinking": false
            },
            {
                "provider": "zed.dev",
                "model": "gpt-5.4",
                "enable_thinking": false
            },
            {
                "provider": "ollama",
                "model": "glm-5.1:cloud",
                "enable_thinking": false
            }
        ],
        "default_profile": "write",
        "default_model": {
            "effort": "medium",
            "enable_thinking": false,
            "provider": "zed.dev",
            "model": "gpt-5.4"
        },
        "model_parameters": []
    },
    "collaboration_panel": {
        "default_width": 0.0,
        "button": true,
        "dock": "left"
    },
    "outline_panel": {
        "button": false,
        "dock": "left"
    },
    "active_pane_modifiers": {
        "inactive_opacity": 1.0
    },
    "agent_ui_font_size": 18.0,
    "git_panel": {
        "tree_view": true,
        "dock": "right"
    },
    "project_panel": {
        "entry_spacing": "comfortable",
        "button": true,
        "dock": "right"
    },
    "debugger": {
        "dock": "right"
    },
    "relative_line_numbers": "enabled",
    "format_on_save": "off",
    "inlay_hints": {
        "show_value_hints": true,
        "show_type_hints": false,
        "show_parameter_hints": false,
        "show_other_hints": false,
        "show_background": false,
        "enabled": true
    },
    "ui_font_family": "FiraCode Nerd Font Mono",
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "git": {
        "inline_blame": {
            "enabled": false
        }
    },
    "buffer_font_family": "FiraCode Nerd Font Mono",
    "hard_tabs": false,
    "tab_size": 2,
    "vim_mode": true,
    "icon_theme": {
        "mode": "dark",
        "light": "Zed (Default)",
        "dark": "Colored Zed Icons Theme Dark"
    },
    "base_keymap": "VSCode",
    "ui_font_size": 16.0,
    "buffer_font_size": 16.0,
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Vague High Contrast"
    }
}
