    secondary-fixed-dim: #bdc7dc;
    on-secondary: #ffffff;
    on-secondary-fixed: #121c2b;
    on-secondary-fixed-variant: #3d4758;
    secondary-container: #d9e3f8;
    on-secondary-container: #121c2b;
    tertiary: #6e5676;
    tertiary-fixed: #f8d8fe;
    tertiary-fixed-dim: #dbbde2;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #27132f;
    on-tertiary-fixed-variant: #553e5d;
    tertiary-container: #f8d8fe;
    on-tertiary-container: #27132f;
