/*****----- Configuration -----*****/
configuration {
	modi:                       "drun,run,window";
    show-icons:                 true;
    icon-theme: "Papirus";
    display-drun:               "";
    display-run:                "run";
    display-window:             "window";
	drun-display-format:        "{name} [<span weight='light' size='small'><i>({generic})</i></span>]";
	window-format:              "{t}    <span alpha='50%'>[{c}]</span>";
}

/*****----- Global Properties -----*****/
//j
@import                          "./colors.rasi"

* {
  font: "JetBrainsMono Nerd Font SemiBold 13";
}


/*****----- Main Window -----*****/
window {
    /* properties for window widget */
    transparency:                "real";
    location:                    north;
    anchor:                      north;
    fullscreen:                  false;
    width:                       500px;
    x-offset:                    0px;
    y-offset:                    24px;
    opacity: 0.94;
    background-color: @surface;

    /* properties for all widgets */
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border: 2px solid;
    border-color: 				@outline-variant;
    border-radius:               12px;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     6px;
    margin:                      0px;
    padding:                     8px;
    border:                      0px solid;
    border-radius:               0px 0px 0px 0px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  @on-surface-variant;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    padding:                     8px 10px 8px 10px;
    border:                      0px;
    border-radius:               0px;
    background-color:            inherit;
    text-color:                  @outline;
    str:                         "";
}
textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "::";
    background-color:            inherit;
    text-color:                  inherit;
}
entry {
    enabled:                     true;
    padding:                     8px 8px 8px 2px;
    background-color:            inherit;
    text-color:                  @on-surface;
    cursor:                      text;
    placeholder:                 "";
    placeholder-color:           @on-surface-variant;
}

/*****----- Messages -----*****/
error-message {
    enabled:                     true;
    expand:                      true;
    padding:                     12px 16px;
    border:                      0px;
    border-radius:               8px;
    background-color:            @surface-container;
    text-color:                  @on-surface-variant;
}
error-message textbox {
    background-color:            transparent;
    text-color:                  @on-surface-variant;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       6;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               true;
    
    spacing:                     2px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                transparent;
    background-color:            transparent;
    text-color:                  @on-surface-variant;
    cursor:                      "default";
}
scrollbar {
    handle-width:                5px ;
    handle-color:                @outline;
    border-radius:               0px;
    background-color:            transparent;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     12px;
    margin:                      0px;
    padding:                     8px 12px;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  @on-surface-variant;
    cursor:                      pointer;
}
element normal.normal {
}
element normal.urgent {
}
element normal.active {
}
element selected.normal {
  background-color: @surface-container-high;
  text-color: @on-surface;
}
element selected.urgent {
  background-color: @error;
}
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        38px;
    cursor:                      inherit;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
